{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "opencode/big-pickle",
  "agents": {
    "explorer": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "coder": {
      "model": "opencode/big-pickle"
    },
    "tester": {
      "model": "opencode/nemotron-3.5-lightning-free"
    },
    "reviewer": {
      "model": "opencode/mimo-v2.6-flash-free"
    }
  }
}
