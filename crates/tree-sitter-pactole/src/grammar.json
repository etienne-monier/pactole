      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "PATTERN",
          "value": "[^)\\r\\n]*"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "key": {
      "type": "PATTERN",
      "value": "[a-z_\\-]+"
    },
