      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "PATTERN",
          "value": "[^\"\\r\\n]*"
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "date": {
      "type": "PATTERN",
      "value": "\\d{4}-\\d{2}-\\d{2}"
    },
    "account": {
      "type": "PATTERN",
      "value": "[A-Z][A-Za-z0-9_\\-]*(?::[A-Za-z0-9_\\-]+)*"
    },
    "commodity_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9'._\\-]{0,22}[A-Z0-9]"
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+(,\\d{3})*(\\.\\d+)?"
    },
    "tolerance": {
      "type": "PATTERN",
      "value": "\\d+(\\.\\d+)?"
    },
    "comment": {
      "type": "PATTERN",
      "value": ";[^\\r\\n]*"
    },
    "_ws": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
